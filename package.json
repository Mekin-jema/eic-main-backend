{
  "name": "green_energy_event",
  "version": "1.0.0",
  "main": "server.ts",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "start": "node dist/server.js",
    "prod": "NODE_ENV=PRODUCTION node dist/server.js",
    "dev": "NODE_ENV=DEVELOPMENT nodemon --exec ts-node src/server.ts",
    "watch": "tsc -w",
    "preview:badges": "ts-node src/scripts/badgePreview.ts",
    "preview:badges:advanced": "ts-node src/scripts/badgePreviewAdvanced.ts",
    "generate:attendee-qr": "ts-node src/scripts/generateAttendeeQR.ts",
    "db:seed": "ts-node src/seed.ts"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "@types/node": "^20.11.30",
    "@types/express": "^5.0.1",
    "@types/mongoose": "^5.11.97",
    "@types/cors": "^2.8.17",
    "@types/cookie-parser": "^1.4.8",
    "@types/multer": "^2.0.0"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongoose": "^9.1.5",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "cookie-parser": "^1.4.7",
    "express-validator": "^7.2.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.6",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "@zxing/library": "^0.21.3",
    "chapa-nodejs": "^2.0.1",
    "xss-clean": "^0.1.4",
      "@types/node": "^20.11.30"

  }
