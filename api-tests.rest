### ===========================================
### AUTH ENDPOINTS TESTS
### ===========================================

# Auth test variables (update as needed)
@authEmail = admin@example.com
@authPassword = Admin123!
@newPassword = AdminPass456!
# The following need manual values from email/dev:
@otpCode = 000000
@resetToken = REPLACE_WITH_TOKEN

### Login: should set admin session cookie
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{authEmail}}",
  "password": "{{authPassword}}"
}

### Forgot Password: send reset link to email
POST {{baseUrl}}/auth/forgot-password
Content-Type: application/json

{
  "email": "{{authEmail}}"
}

### Request OTP: send 6-digit code to email
POST {{baseUrl}}/auth/request-otp
Content-Type: application/json

{
  "email": "{{authEmail}}"
}

### Verify OTP: replace {{otpCode}} with the emailed code
POST {{baseUrl}}/auth/verify-otp
Content-Type: application/json

{
  "code": "{{otpCode}}"
}

### Reset Password: replace {{resetToken}} with token from email
POST {{baseUrl}}/auth/reset-password
Content-Type: application/json

{
  "token": "{{resetToken}}",
  "password": "{{newPassword}}"
}

### Logout: clear admin session cookie
POST {{baseUrl}}/auth/logout

### Seed Admin: create admin user (one-time)
POST {{baseUrl}}/auth/seed-admin
Content-Type: application/json

{
  "email": "{{authEmail}}",
  "password": "{{authPassword}}",
  "name": "Admin"
}

